<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="exercise"
            type="br.com.myworkout.data.Exercise" />

    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/default_8dp"
        android:background="@drawable/rounded_item_bg"
        android:clickable="true"
        android:foreground="?android:attr/selectableItemBackground"
        android:padding="@dimen/default_5dp">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/select_image"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_marginStart="@dimen/default_5dp"
            android:scaleType="centerCrop"
            app:imgUrl="@{exercise.image}"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:shapeAppearance="@style/roundedImageViewRet"
            tools:srcCompat="@tools:sample/backgrounds/scenic" />

        <TextView
            android:id="@+id/select_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/default_18dp"
            android:layout_marginTop="@dimen/default_5dp"
            android:layout_marginEnd="@dimen/default_5dp"
            android:layout_marginBottom="@dimen/default_8dp"
            android:fontFamily="sans-serif-black"
            android:textColor="@color/black"
            android:textSize="@dimen/default_18sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toStartOf="@id/select_type"
            app:layout_constraintStart_toEndOf="@id/select_image"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="Supino Reto" />

        <TextView
            android:id="@+id/select_subname"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/default_18dp"
            android:layout_marginTop="@dimen/default_5dp"
            android:layout_marginEnd="@dimen/default_5dp"
            android:layout_marginBottom="@dimen/default_8dp"
            android:text="0 series - 0 repetições - 0kg"
            android:textColor="#FFFFFF"
            android:textSize="@dimen/default_14sp"
            app:layout_constraintEnd_toStartOf="@id/select_type"
            app:layout_constraintStart_toEndOf="@id/select_image"
            app:layout_constraintTop_toBottomOf="@id/select_name" />

        <TextView
            android:id="@+id/select_type"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/default_8dp"
            android:layout_marginEnd="@dimen/default_5dp"
            android:layout_marginBottom="@dimen/default_8dp"
            android:background="@drawable/rounded_bg_select_exercise"
            android:fontFamily="sans-serif-black"
            android:gravity="center"
            android:padding="@dimen/default_4dp"
            android:textColor="@color/white"
            android:textSize="@dimen/default_14sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="Peito" />


    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>